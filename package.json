{
  "name": "poly-pro",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Pro-grade metronome with recording and analytics",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run test:run && npm run build && npm run test:e2e",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "axe-core": "^4.12.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.8.3",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
