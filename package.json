{
  "name": "poly-pro",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Pro-grade metronome with recording and analytics",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:browser": "playwright test tests/e2e/hardening.spec.ts",
    "test:stability": "playwright test tests/e2e/stability.spec.ts",
    "test:all": "npm run lint && npm run test:run && npm run audit:all && npm run build && npm run test:browser",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "audit:all": "npm audit --audit-level=low"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.0.4",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.25",
    "tailwindcss": "3.4.17",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "@playwright/test": "^1.55.0",
    "axe-core": "^4.10.3"
  }
}
